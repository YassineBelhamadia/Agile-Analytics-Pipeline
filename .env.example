# Copy to .env and replace the placeholders. .env is gitignored; never commit real values.
# Nothing reads this file by itself: pass it with --env-file .env (docker compose, uv run).
# Read by warehouse/docker-compose.yml, scripts/check_warehouse.py, ingestion.load_staging
# and ingestion.extract.

POSTGRES_USER=aap
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=aap_warehouse

# Host side of the connection. 5433 by default because a locally installed
# Postgres commonly already holds 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Extraction (ingestion.extract): the mock API's base URL, with scheme, and a
# Bearer token. The mock accepts any non-empty token.
AAP_API_BASE_URL=http://localhost:8000
AAP_API_TOKEN=replace-with-any-value
