# Copy to .env and replace the placeholders. .env is gitignored; never commit real values.
# Read by warehouse/docker-compose.yml (via --env-file .env) and by scripts/check_warehouse.py.

POSTGRES_USER=aap
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=aap_warehouse

# Host side of the connection. 5433 by default because a locally installed
# Postgres commonly already holds 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
