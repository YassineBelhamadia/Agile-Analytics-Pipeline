{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch -c *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git rebase *)",
      "Bash(* --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(* --force*)",
      "Bash(git * -f)",
      "Bash(git * -f *)",
      "Bash(git branch -D *)",
      "Bash(git switch main *)",
      "Bash(git switch * main)",
      "Bash(git switch -)",
      "Bash(git checkout main *)",
      "Bash(git checkout * main)",
      "Bash(git checkout -)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(git config *)",
      "Bash(docker compose down*-v*)",
      "Bash(docker compose * down*-v*)",
      "Bash(docker-compose *down*-v*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*--volumes*)",
      "Bash(*AAP_ALLOW_MAIN*)",
      "Bash(*AAP_SKIP_DOCS_CHECK*)"
    ]
  }
}
